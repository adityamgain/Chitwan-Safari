<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Your Adventure - Chitwan Adventures</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/media.css" />
</head>
<body>

<section class="hero">
    <div class="hero-content">
        <h1>Discover the Wild</h1>
        <p>Experience breathtaking safaris with expert guides in untouched nature.</p>
        <a href="#media" class="btn">Explore Gallery</a>
    </div>
</section>

<div class="media-gallery container" id="media">
    <div class="media-controls">
        <div class="toggle-buttons" role="tablist">
            <button id="show-images" class="toggle-btn <%= currentView === 'images' ? 'active' : '' %>" role="tab" aria-selected="<%= currentView === 'images' ? 'true' : 'false' %>" aria-controls="images-container">
                <i class="fas fa-images"></i> Images
            </button>
            <button id="show-videos" class="toggle-btn <%= currentView === 'videos' ? 'active' : '' %>" role="tab" aria-selected="<%= currentView === 'videos' ? 'true' : 'false' %>" aria-controls="videos-container">
                <i class="fas fa-video"></i> Videos
            </button>
            <span class="toggle-slider"></span>
        </div>

        <div class="filter-controls">
            <select id="page-size-filter" class="filter-select">
                <option value="12" <%= pageSize == 12 ? 'selected' : '' %>>12 per page</option>
                <option value="6" <%= pageSize == 6 ? 'selected' : '' %>>6 per page</option>
                <option value="24" <%= pageSize == 24 ? 'selected' : '' %>>24 per page</option>
                <option value="48" <%= pageSize == 48 ? 'selected' : '' %>>48 per page</option>
            </select>
        </div>
    </div>

    <div class="media-stats">
        <% if (currentView === 'images') { %>
            Showing <%= allImages.length %> stunning wildlife images from our Chitwan adventures
        <% } else if (currentView === 'videos') { %>
            Showing <%= allVideos.length %> exciting wildlife videos from our adventures
        <% } else { %>
            Showing <%= allImages.length + allVideos.length %> media items from our adventures
        <% } %>
    </div>

    <!-- Images Container -->
    <div id="images-container" class="media-container <%= currentView === 'videos' ? 'hidden' : '' %>">
        <div class="media-grid">
            <% if (allImages && allImages.length > 0) { %>
                <% allImages.forEach((filename) => { %>
                    <div class="media-item">
                        <img
                                src="/images/<%= filename %>"
                                alt="<%= filename.replace(/[-_]/g, ' ').split('.')[0] %>"
                                onclick="openLightbox(this.src, this.alt)"
                        />
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #777; font-style: italic;">No images available.</p>
            <% } %>
        </div>
    </div>

    <!-- Videos Container -->
    <div id="videos-container" class="media-container <%= currentView === 'images' ? 'hidden' : '' %>">
        <div class="media-grid">
            <% if (allVideos && allVideos.length > 0) { %>
                <% allVideos.forEach((video) => { %>
                    <div class="media-item video-item">
                        <video controls>
                            <source
                                    src="/videos/<%= video.filename %>"
                                    type="video/<%= video.ext %>"
                            />
                            Your browser does not support the video tag.
                        </video>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #777; font-style: italic;">No videos available.</p>
            <% } %>
        </div>
    </div>
</div>

<!-- Pagination Controls -->
<% if (pagination.total > 1) { %>
    <div class="pagination">
        <% if (pagination.hasPrev) { %>
            <a href="?type=<%= mediaType %>&page=<%= pagination.prev %>&pageSize=<%= pageSize %>&sort=<%= sort %>" class="page-link prev">
                <i class="fas fa-chevron-left"></i> Prev
            </a>
        <% } else { %>
            <span class="page-link prev disabled">
            <i class="fas fa-chevron-left"></i> Prev
        </span>
        <% } %>

        <div class="page-numbers">
            <% for (let i = 1; i <= pagination.total; i++) { %>
                <% if (i === pagination.current) { %>
                    <span class="page-link current"><%= i %></span>
                <% } else { %>
                    <a href="?type=<%= mediaType %>&page=<%= i %>&pageSize=<%= pageSize %>&sort=<%= sort %>" class="page-link"><%= i %></a>
                <% } %>
            <% } %>
        </div>

        <% if (pagination.hasNext) { %>
            <a href="?type=<%= mediaType %>&page=<%= pagination.next %>&pageSize=<%= pageSize %>&sort=<%= sort %>" class="page-link next">
                Next <i class="fas fa-chevron-right"></i>
            </a>
        <% } else { %>
            <span class="page-link next disabled">
            Next <i class="fas fa-chevron-right"></i>
        </span>
        <% } %>
    </div>
<% } %>

<!-- Enhanced Fullscreen Lightbox -->
<div id="lightbox" class="lightbox">
    <span class="close-btn" onclick="closeLightbox(event)">×</span>
    <button class="lightbox-nav prev" onclick="navigateLightbox(-1, event)">‹</button>
    <button class="lightbox-nav next" onclick="navigateLightbox(1, event)">›</button>
    <div class="lightbox-container">
        <img id="lightbox-img" class="lightbox-content" />
    </div>
    <div class="lightbox-counter" id="lightbox-counter"></div>
    <div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<script>
    // Lightbox functionality for fullscreen viewing
    let currentImageIndex = 0;
    let allImageElements = [];

    function openLightbox(src, alt) {
        // Get all visible images in the current container
        const activeContainer = document.querySelector('.media-container:not(.hidden)');
        allImageElements = Array.from(activeContainer.querySelectorAll('img'));
        currentImageIndex = allImageElements.findIndex(img => img.src === src);

        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const caption = document.getElementById('lightbox-caption');
        const counter = document.getElementById('lightbox-counter');

        lightboxImg.src = src;
        caption.textContent = alt;
        counter.textContent = `${currentImageIndex + 1} / ${allImageElements.length}`;

        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Prevent page scrolling while lightbox is open
        document.addEventListener('wheel', preventScroll, { passive: false });
        document.addEventListener('touchmove', preventScroll, { passive: false });
    }

    function closeLightbox(event) {
        if (event) event.stopPropagation();
        const lightbox = document.getElementById('lightbox');
        lightbox.classList.remove('active');
        document.body.style.overflow = '';

        // Re-enable page scrolling
        document.removeEventListener('wheel', preventScroll);
        document.removeEventListener('touchmove', preventScroll);
    }

    function preventScroll(e) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }

    function navigateLightbox(direction, event) {
        if (event) event.stopPropagation();
        if (allImageElements.length === 0) return;

        currentImageIndex += direction;

        // Handle wrap-around
        if (currentImageIndex < 0) {
            currentImageIndex = allImageElements.length - 1;
        } else if (currentImageIndex >= allImageElements.length) {
            currentImageIndex = 0;
        }

        const lightboxImg = document.getElementById('lightbox-img');
        const caption = document.getElementById('lightbox-caption');
        const counter = document.getElementById('lightbox-counter');

        lightboxImg.src = allImageElements[currentImageIndex].src;
        caption.textContent = allImageElements[currentImageIndex].alt;
        counter.textContent = `${currentImageIndex + 1} / ${allImageElements.length}`;

        // Add fade effect
        lightboxImg.style.animation = 'none';
        setTimeout(() => {
            lightboxImg.style.animation = 'lightboxZoom 0.3s ease-out';
        }, 10);
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Set initial state based on server-side currentView
        const showImagesBtn = document.getElementById('show-images');
        const showVideosBtn = document.getElementById('show-videos');
        const imagesContainer = document.getElementById('images-container');
        const videosContainer = document.getElementById('videos-container');
        const toggleButtons = document.querySelector('.toggle-buttons');
        const pageSizeFilter = document.getElementById('page-size-filter');

        // Add click event listeners to all images
        function addImageClickListeners() {
            const images = document.querySelectorAll('#images-container img');
            images.forEach(img => {
                img.addEventListener('click', function() {
                    openLightbox(this.src, this.alt);
                });
            });
        }

        // Initialize image click listeners
        addImageClickListeners();

        // View toggle functionality
        function switchToImages() {
            showImagesBtn.classList.add('active');
            showVideosBtn.classList.remove('active');
            imagesContainer.classList.remove('hidden');
            videosContainer.classList.add('hidden');
            toggleButtons.classList.remove('videos-active');

            // Update stats
            const imageCount = document.querySelectorAll('#images-container .media-item').length;
            document.querySelector('.media-stats').textContent = `Showing ${imageCount} stunning wildlife images from our Chitwan adventures`;
            addImageClickListeners();
        }

        function switchToVideos() {
            showVideosBtn.classList.add('active');
            showImagesBtn.classList.remove('active');
            videosContainer.classList.remove('hidden');
            imagesContainer.classList.add('hidden');
            toggleButtons.classList.add('videos-active');

            // Update stats
            const videoCount = document.querySelectorAll('#videos-container .media-item').length;
            document.querySelector('.media-stats').textContent = `Showing ${videoCount} exciting wildlife videos from our adventures`;
        }

        showImagesBtn.addEventListener('click', switchToImages);
        showVideosBtn.addEventListener('click', switchToVideos);

        // Page size filter functionality
        pageSizeFilter.addEventListener('change', function() {
            const newPageSize = this.value;
            const url = new URL(window.location.href);
            url.searchParams.set('pageSize', newPageSize);
            window.location.href = url.toString();
        });

        // Keyboard navigation for lightbox
        document.addEventListener('keydown', (e) => {
            const lightbox = document.getElementById('lightbox');
            if (lightbox && lightbox.classList.contains('active')) {
                if (e.key === 'Escape') {
                    closeLightbox();
                } else if (e.key === 'ArrowLeft') {
                    navigateLightbox(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateLightbox(1);
                }
            }
        });

        // Close lightbox when clicking on the background
        document.getElementById('lightbox').addEventListener('click', function(e) {
            if (e.target === this || e.target.classList.contains('lightbox-container')) {
                closeLightbox();
            }
        });

        // Prevent lightbox from closing when clicking on image
        document.getElementById('lightbox-img').addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });
</script>

</body>
</html>