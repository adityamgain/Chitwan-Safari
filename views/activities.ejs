<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chitwan Adventures - Experience Nepal's Wild Side</title>
    <link rel="stylesheet" href="/css/activities.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

<section class="hero">
    <h1>Experience the Wild Heart of Nepal</h1>
    <p>Discover the breathtaking beauty of Chitwan National Park through our carefully curated adventure activities and authentic cultural experiences.</p>
</section>

<section class="container" id="activities">

    <!-- Jungle Safari -->
    <div class="activity-row">
        <div class="activity-image">
            <img src="../images/rhino.jpeg" alt="Jungle Safari" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Jungle Safari</h3>
                <p class="activity-description">
                    Embark on an exciting jeep safari through Chitwan National Park to spot rhinos, tigers, elephants and other wildlife in their natural habitat. Our expert guides will take you through the best routes to maximize wildlife sightings while ensuring your safety.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>4-6 hours</span>
                </div>
                <a href="/activities/safari" class="btn">Explore</a>
            </div>
        </div>
    </div>

    <!-- Canoeing -->
    <div class="activity-row reverse">
        <div class="activity-image">
            <img src="../images/canoening_crop.jpeg" alt="Canoeing" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Canoeing Adventure</h3>
                <p class="activity-description">
                    Paddle down the Rapti River in traditional dugout canoes, observing crocodiles, water birds and stunning riverine landscapes. This peaceful journey offers a unique perspective of the park's aquatic ecosystem.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>2-3 hours</span>
                </div>
                <a href="/activities/canoeing" class="btn">Explore</a>
            </div>
        </div>
    </div>

    <!-- Jungle Walk -->
    <div class="activity-row">
        <div class="activity-image">
            <img src="../images/jungle-walk.jpeg" alt="Jungle Walk" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Guided Jungle Walk</h3>
                <p class="activity-description">
                    Explore the jungle on foot with our expert naturalists, learning about flora, fauna and animal tracking in this UNESCO World Heritage Site. Experience the thrill of walking through elephant grass taller than you, with the possibility of encountering wildlife up close.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>3-4 hours</span>
                </div>
                <a href="/activities/jungle-walk" class="btn">Explore</a>
            </div>
        </div>
    </div>

    <!-- Jatayu Vulture Feeding Center -->
    <div class="activity-row reverse">
        <div class="activity-image">
            <img src="../images/jatayou.jpg" alt="Jatayu Vulture Feeding Center" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Jatayu Vulture Feeding Center</h3>
                <p class="activity-description">
                    Visit this vital conservation site dedicated to protecting Nepal's endangered vultures. Learn about their role in the ecosystem and witness these majestic birds feeding safely.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>1-2 hours</span>
                </div>
                <a href="/activities/jatayu-vulture-feeding" class="btn">Explore</a>
            </div>
        </div>
    </div>


    <!-- Homestay -->
    <div class="activity-row reverse">
        <div class="activity-image">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" alt="Tharu Homestay" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Tharu Homestay</h3>
                <p class="activity-description">
                    Live with a local Tharu family in their traditional home, experiencing their daily life, customs and warm hospitality firsthand. This immersive experience includes home-cooked meals, participation in daily activities, and insights into Tharu culture that few visitors get to experience.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>1+ nights</span>
                </div>
                <a href="/activities/homestay" class="btn">Explore</a>
            </div>
        </div>
    </div>

    <!-- Tharu Community -->
    <div class="activity-row">
        <div class="activity-image">
            <img src="../images/culture-dance.JPG" alt="Tharu Community" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Tharu Community Experience</h3>
                <p class="activity-description">
                    Immerse yourself in the culture of the indigenous Tharu people through village tours, traditional dance performances and local cuisine. Learn about their unique relationship with the jungle and their traditional methods of farming and building.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>2-4 hours</span>
                </div>
                <a href="/activities/tharu" class="btn">Explore</a>
            </div>
        </div>
    </div>

    <!-- Sunset -->
    <div class="activity-row reverse">
        <div class="activity-image">
            <img src="../images/sunset-tourist.jpeg" alt="Tharu Homestay" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Sunset Viewing</h3>
                <p class="activity-description">
                    Witness breathtaking sunsets over the lush Chitwan landscape. Enjoy the serene colors as the sun dips below the horizon, creating perfect photo opportunities and peaceful moments in nature.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>1-2 hours</span>
                </div>
                <a href="/activities/sunsets" class="btn">Explore</a>
            </div>
        </div>
    </div>

    <!-- Bird Watching -->
    <div class="activity-row">
        <div class="activity-image">
            <img src="../images/jungle-walk.jpeg" alt="Bird Watching" />
        </div>
        <div class="activity-content">
            <div>
                <h3 class="activity-title">Bird Watching</h3>
                <p class="activity-description">
                    With over 500 species of birds, Chitwan is a paradise for birders. Spot rare species like the Bengal florican and giant hornbill. Our specialized birding guides know all the best locations and can identify birds by both sight and sound.
                </p>
            </div>
            <div class="activity-meta">
                <div class="activity-duration">
                    <i class="fas fa-clock"></i>
                    <span>2-4 hours</span>
                </div>
                <a href="/activities/tharu" class="btn">Explore</a>
            </div>
        </div>
    </div>

</section>

<section class="cta">
    <div class="container">
        <h2>Ready for Your Adventure?</h2>
        <p>Book your jungle experience today and create memories that will last a lifetime.</p>
        <div class="cta-buttons">
            <a href="/booking" class="btn btn-large">Book Now</a>
            <a href="/contact" class="btn btn-large btn-outline">Contact Us</a>
        </div>
    </div>
</section>

</body>
</html>
