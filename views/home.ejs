<script>
    const imagesBtn = document.getElementById('show-images');
    const videosBtn = document.getElementById('show-videos');
    const imagesContainer = document.getElementById('images-container');
    const videosContainer = document.getElementById('videos-container');

    imagesBtn.addEventListener('click', () => {
        imagesContainer.style.display = 'block';
        videosContainer.style.display = 'none';
        imagesBtn.style.backgroundColor = '#00796b';
        imagesBtn.style.color = '#fff';
        videosBtn.style.backgroundColor = '#e0e0e0';
        videosBtn.style.color = '#333';
    });

    videosBtn.addEventListener('click', () => {
        videosContainer.style.display = 'block';
        imagesContainer.style.display = 'none';
        videosBtn.style.backgroundColor = '#00796b';
        videosBtn.style.color = '#fff';
        imagesBtn.style.backgroundColor = '#e0e0e0';
        imagesBtn.style.color = '#333';
    });

</script>

