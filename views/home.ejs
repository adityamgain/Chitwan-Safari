    <section class="media-section">
        <div class="container">
            <!-- Section Header -->
            <div class="section-header">
                <h2 class="section-title">Explore Our Visual Journey</h2>
                <p class="section-subtitle">
                    Relive every adventure through breathtaking images and immersive videos of Chitwan’s most thrilling moments.
                </p>
            </div>

            <!-- Toggle Buttons -->
            <div class="toggle-buttons">
                <button id="show-images" class="toggle-btn active">Images</button>
                <button id="show-videos" class="toggle-btn">Videos</button>
            </div>

            <!-- Images Grid -->
            <div id="images-container" class="media-container">
                <div class="media-grid">
                    <% if (randomImages && randomImages.length) { %>
                        <% randomImages.forEach((filename) => { %>
                            <div class="media-item">
                                <img
                                        src="/images/<%= filename %>"
                                        alt="<%= filename.replace(/[-_]/g, ' ').split('.')[0] %>"
                                        onclick="openLightbox(this.src)"
                                />
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #777; font-style: italic;">No images available.</p>
                    <% } %>
                </div>
            </div>

            <!-- Lightbox Modal -->
            <div id="lightbox" class="lightbox" onclick="closeLightbox()">
                <span class="close-btn" onclick="closeLightbox()">×</span>
                <img id="lightbox-img" class="lightbox-content" />
            </div>


            <!-- Videos Grid -->
            <div id="videos-container" class="media-container hidden">
                <div class="media-grid">
                    <% if (randomVideos && randomVideos.length) { %>
                        <% randomVideos.forEach((video) => { %>
                            <div class="media-item video-item">
                                <video controls>
                                    <source
                                            src="/videos/<%= video.filename %>"
                                            type="video/<%= video.ext %>"
                                    />
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #777; font-style: italic;">No videos available.</p>
                    <% } %>
                </div>
            </div>

            <div class="media-btn">
                <a href="/media" class="btn-media-small">View All</a>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonials">
        <div class="container">
            <h2>What Our Visitors Say</h2>
            <!-- Button to navigate to review form -->
            <div class="testimonial-form-btn">
                <a href="/testimonials" class="btn-small">View and Add Reviews</a>
            </div>

            <% if (reviews && reviews.length > 0) { %>
                <div class="testimonial-slider">
                    <% reviews.forEach((review, index) => { %>
                        <div class="testimonial <%= index === 0 ? 'active' : '' %>">
                            <p>"<%= review.review %>"</p>
                            <div class="author">- <%= review.name %>, <%= review.country %></div>
                        </div>
                    <% }); %>
                </div>
                <div class="slider-controls">
                    <button class="slider-prev"><i class="fas fa-chevron-left"></i></button>
                    <button class="slider-next"><i class="fas fa-chevron-right"></i></button>
